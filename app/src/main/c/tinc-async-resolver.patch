+		cache->aip = cache->ai = lookup->ai;
+		lookup->ai = NULL;
+		cache->next_lookup++;
 	}
 
-	// We're all out of addresses.
-	exit_configuration(&cache->config_tree);
-	return false;
+	sockaddr_t *sa = (sockaddr_t *)cache->aip->ai_addr;
